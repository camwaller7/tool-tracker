# Copy to .env and fill in to enable real notification delivery and override
# defaults. All are optional — with none set, the server runs and logs
# notifications to the console instead of sending them.

# Core
# PORT=4000
# JWT_SECRET=change-me-in-production
# DB_PATH=./tool-tracker.db
# UPLOAD_DIR=./uploads

# SMS (damage / strike / supervised / locked) — Twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM=+61400000000

# Email (6pm overdue digest) — any SMTP provider
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey-or-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=tools@yourbusiness.example

# Copy to .env for local dev. In production these are set as Vercel env vars
# (Postgres + Blob are injected automatically when you connect those stores).

# Database — Postgres. Locally, point at any Postgres; in prod the Vercel
# Postgres/Neon integration injects POSTGRES_URL for you.
POSTGRES_URL=postgresql://postgres@127.0.0.1:5432/tooltracker

# Auth
JWT_SECRET=change-me-in-production

# Photo storage — Vercel Blob. With no token set, photos are stored on local
# disk instead (dev only). The Vercel Blob store injects this in prod.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Cron protection — Vercel signs cron requests with this as a Bearer token.
# CRON_SECRET=some-long-random-string

# SMS (damage / strike / supervised / locked) — Twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM=+61400000000

# Email (6pm overdue digest) — any SMTP provider
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey-or-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=tools@yourbusiness.example

{
  "name": "tool-tracker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Site Tool Tracker — API + build (deployed on Vercel)",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/src/index.js",
    "start": "node --env-file-if-exists=.env server/src/index.js",
    "migrate": "node --env-file-if-exists=.env server/src/migrate.js",
    "seed": "node --env-file-if-exists=.env server/src/seed.js",
    "nightly": "node --env-file-if-exists=.env server/src/jobs/nightly.js",
    "build": "cd web && npm install && npm run build"
  },
  "dependencies": {
    "@vercel/blob": "^0.27.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1"
  }
}
